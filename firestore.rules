rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /side_projects/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // 고수 vs 홍어 투표 — 로그인 없이도 누구나 카운트를 1씩만 올릴 수 있게 허용.
    // (한쪽 필드만, 정확히 +1 인지 규칙에서 검증해서 임의 값 조작을 막음)
    match /votes/gosu-hongeo {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['gosu', 'hongeo']) && (
        (request.resource.data.gosu == 1 && request.resource.data.hongeo == 0) ||
        (request.resource.data.hongeo == 1 && request.resource.data.gosu == 0)
      );
      allow update: if request.resource.data.keys().hasOnly(['gosu', 'hongeo']) && (
        (request.resource.data.gosu == resource.data.gosu + 1 && request.resource.data.hongeo == resource.data.hongeo) ||
        (request.resource.data.hongeo == resource.data.hongeo + 1 && request.resource.data.gosu == resource.data.gosu)
      );
    }
  }
}
